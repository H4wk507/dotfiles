#!/bin/sh

# Clean the log files in the /var/log directory

set -eu

log() {
    [ "$verbose" = true ] && echo "$@"
}

verbose=false
for arg in "$@"; do
    case "$arg" in
        -v|--verbose)
            verbose=true
            shift
            ;;
    esac
done

root_uid=0
[ "$(id -u)" -eq "$root_uid" ] || { echo "Must be root to run this script." >&2; exit 1; }

log_dir=/var/log
cd $log_dir || { echo "Can't change to $log_dir." >&2; exit 1; }

set -- messages wtmp syslog dmesg kern.log auth.log

for file in "$@"; do
    log "Cleaning file: $file"
    cat /dev/null > "$file"
done

echo "Logs cleaned up."
exit 0
