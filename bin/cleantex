#!/bin/sh

# Clean up the LaTeX files generated by the LaTeX compiler. Run from the
# directory containing the LaTeX source files.

set -eu

verbose=false
for arg in "$@"; do
    case "$arg" in
        -v|--verbose)
            verbose=true
            shift
            ;;
    esac
done

set -- *.aux *.bbl *.blg *.dvi *.log *.out \
    *.toc *.lof *.lot *.idx *.ilg *.ind *.brf \
    *.cb *.cb2 *.synctex.gz *.fdb_latexmk *.fls \
    *.nav *.snm *.vrb

if [ "$verbose" = true ]; then 
    rm -fv "$@" 
else 
    rm -f "$@"
fi
