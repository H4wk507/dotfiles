Include ~/.orbstack/ssh/config

Host git.gorrion.pl
    IdentityAgent none
    IdentityFile ~/.ssh/id_ed25519_gorrion
    IdentitiesOnly yes

Host *
	IdentityAgent ~/Library/Containers/com.maxgoedjen.Secretive.SecretAgent/Data/socket.ssh

Host vm vmroot
    HostName localhost
    Port 2222

Host vm
    User user

Host vmroot
    User root

Host storagebox
    HostName u672410.your-storagebox.de
    User u672410
    Port 23
    IdentityFile ~/.ssh/id_ed25519_borg_hetzner
    IdentitiesOnly yes
