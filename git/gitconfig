[user]
	name = Piotr Skowroński
    email = hxwk@mailbox.org
[init]
	defaultBranch = main
[status]
    showUntrackedFiles = all
[diff]
	tool = nvimdiff
	algorithm = histogram
	renames = copies
	colorMoved = plain
	mnemonicPrefix = true
[difftool]
	prompt = false
[oh-my-zsh]
	hide-dirty = 1
[core]
	editor = nvim
	pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    light = false
    side-by-side = true
[merge]
	tool = nvimdiff
	conflictStyle = zdiff3
[alias]
	graph = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
[push]
	autosetupremote = true
	followTags = true
[branch]
	sort = -committerdate
[column]
    ui = auto
[tag]
	sort = version:refname
[fetch]
	prune = true
	pruneTags = true
	all = true
[commit]
	verbose = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[pull]
	rebase = true
[rebase]
	autosquash = true
	autostash = false
	updateRefs = true
[rerere]
    enabled = true
    autoupdate = false
[includeIf "gitdir:~/job/"]
	path = ~/.gitconfig-job
