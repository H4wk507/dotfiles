# Functions

# Get password from KeePassXC securely
function kpget() {
    [[ -n $KP_PASS ]] || { IFS= read -rs "KP_PASS?KeePassXC master pass: "; print -u2 }
    local v
    v=$(print -r -- "$KP_PASS" | keepassxc-cli show -q -s -a Password "$HOME/Passwords.kdbx" "$1") || { unset KP_PASS; return 1 }
    [[ -n $v ]] || { print -u2 "kpget: empty '$1'"; return 1 }
    print -r -- "$v"
}

# Claude Code + Remote Control
function cw() {
    local name="${1:-${PWD:t}}"

    local -a cmd=(
        env -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL
        -u DISABLE_TELEMETRY -u DO_NOT_TRACK
        -u DISABLE_GROWTHBOOK -u CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC
        -u CLAUDE_CODE_OAUTH_TOKEN
        claude --permission-mode acceptEdits --remote-control "$name" "$@"
    )

    if _is_macos; then
        caffeinate -ims "${cmd[@]}"
    else
        "${cmd[@]}"
    fi
}

alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

# OpenCode Web + Remote Control via Tailscale
function ocw() {
    local port=4096
    local pwfile="$HOME/.config/opencode/server-password"

    if [[ ! -f $pwfile ]]; then
        mkdir -p ${pwfile:h}
        openssl rand -base64 8 | tr -d '\n' > $pwfile
        chmod 600 $pwfile
    fi

    command -v tailscale >/dev/null || { print -u2 "tailscale not found"; return 1 }
    command -v jq >/dev/null || { print -u2 "jq not found"; return 1 }

    local pw="$(<$pwfile)"
    export OPENCODE_SERVER_PASSWORD="$pw"

    opencode web --hostname 127.0.0.1 --port $port &
    local pid=$!

    trap "kill $pid 2>/dev/null; tailscale serve --https=443 off >/dev/null 2>&1; unset OPENCODE_SERVER_PASSWORD" EXIT INT TERM

    _is_macos && caffeinate -imsw $pid &

    tailscale serve --bg --https=443 "http://127.0.0.1:${port}" >/dev/null || return 1

    local host=${$(tailscale status --json | jq -r '.Self.DNSName')%.}
    print -P "%F{green}→%f https://${host}/   user: opencode   password: ${pw}"
    wait $pid
}

# List packages
# Usage: qi [package] or qi to list all packages
function qi() {
    local out
    if (( $+commands[dpkg-query] )); then
        out=$(
            dpkg-query -W -f '${db:Status-Abbrev}\t${Package}\t${Version}\n' 2>/dev/null \
                | awk -F'\t' '$1 ~ /^ii/ { printf("%s\t%s\t\n", $2, $3) }'
            (( $+commands[snap] )) && snap list 2>/dev/null \
                | awk 'NR>1 { printf("%s\t%s\t[snap]\n", $1, $2) }'
            (( $+commands[flatpak] )) && flatpak list --columns=application,version 2>/dev/null \
                | awk -F'\t' '{ printf("%s\t%s\t[flatpak]\n", $1, $2) }'
        )
    elif (( $+commands[brew] )); then
        out=$(
            brew list --formula --versions 2>/dev/null \
                | awk '{ name=$1; $1=""; sub(/^ /,""); printf("%s\t%s\t\n", name, $0) }'
            brew list --cask --versions 2>/dev/null \
                | awk '{ name=$1; $1=""; sub(/^ /,""); printf("%s\t%s\t[cask]\n", name, $0) }'
            (( $+commands[mas] )) && mas list 2>/dev/null \
                | awk '{ id=$1; $1=""; sub(/^ /,""); printf("%s\t\t[appstore]\n", $0) }'
        )
    else
        print -u2 "qi: Didn't found dpkg nor brew"
        return 1
    fi
    print -r -- "$out" | awk -v argline="$*" '
        BEGIN { n = split(tolower(argline), fwords, / +/) }
        function include(hay,   i) {
            for (i = 1; i <= n; i++)
                if (fwords[i] != "" && index(tolower(hay), fwords[i]) == 0) return 0
            return 1
        }
        NF && include($0) { printf("%-32s %-22s %s\n", $1, $2, $3) }
    ' FS='\t'
}

function big-files() {
    local dir=${1:-.} factor pf
    local -a statfmt
 
    if [[ ${2:l} == gib ]]; then
        factor=$((1024 ** 3)); pf=GiB
    else
        factor=$((1024 ** 2)); pf=MiB
    fi
 
    if stat --version &>/dev/null; then
        statfmt=(-c '%s	%n')
    else
        statfmt=(-f '%z	%N')
    fi
 
    find "$dir" -type f -exec stat "${statfmt[@]}" {} + 2>/dev/null \
        | sort -nr -k1 \
        | awk -F'\t' -v factor="$factor" -v pf="$pf" \
              '{ printf("%8.2f %s\t%s\n", $1/factor, pf, $2) }'
}

function big-dirs() {
    local dir=${1:-.} factor pf
 
    if [[ ${2:l} == gib ]]; then
        factor=$((1024 ** 3)); pf=GiB
    else
        factor=$((1024 ** 2)); pf=MiB
    fi
 
    find "$dir" -mindepth 1 -maxdepth 1 -type d -print0 2>/dev/null \
        | xargs -0 du -sk 2>/dev/null \
        | sort -nr -k1 \
        | awk -F'\t' -v factor="$factor" -v pf="$pf" \
              '{ printf("%8.2f %s\t%s\n", ($1 * 1024)/factor, pf, $2) }'
}

function muxvideo() {
    ffmpeg -i "$1" -i "$2" -c:v copy -c:a aac "$3"
}

function burnsubs() {
    video="$1"
    subs="$2"
    ffmpeg -i "$video" -i "$subs" -c copy -c:s mov_text outfile.mp4
}

# Align envs between gdb and shell to prevent stack misalignment
# NOTE: unset LINES and COLUMNS envs inside gdb
# Usage: align-envs gdb ./main -q
function align-envs() {
    env -i PWD="$(pwd)" SHELL="/bin/bash" SHLVL=0 "$@"
}

function fz() { local f; f=$(fzf) && nvim "$f"; }

